# Copy to .env.local and fill in real values. Never commit .env.local.
# This file lists the environment variables NextKey OS reads — no real
# values, placeholders only.

# --- App ---
NEXT_PUBLIC_APP_URL=
NODE_ENV=development

# --- Supabase (Postgres, Auth, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
ANTHROPIC_API_KEY=

# --- Maps / property data ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
BATCHDATA_API_KEY=
REAPI_KEY=
RENTCAST_API_KEY=
BEACHES_MLS_API_URL=
BEACHES_MLS_API_KEY=
BEACHES_MLS_CLIENT_ID=
BEACHES_MLS_CLIENT_SECRET=
MIAMI_DADE_CLERK_KEY=
MD_CLERK_AUTH_KEY=
TWOCAPTCHA_API_KEY=

# --- Communications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# --- Google Workspace (Gmail integration) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Security ---
OAUTH_ENCRYPT_KEY=
CRON_SECRET=
SPESIO_WEBHOOK_SECRET=

# --- Scheduled jobs ---
CRON_INGEST_DISTRESS_ENABLED=
CRON_REFRESH_SAVED_ENABLED=
